use flake .

# Keep the built app in step with the checkout.
#
# `gotg` inside this shell runs the working tree, but a Steam launcher does not:
# it execs ~/.local/state/gotg/app, a `nix build -o` symlink that stays at
# whatever it was last built from. So testing a change by launching the game
# from Steam tested yesterday's code — a slow and confusing way to find out.
#
# watch_dir makes direnv reload when anything under src/client/ changes; `use flake`
# already watches flake.nix and flake.lock.
watch_dir src/client

_gotg_app="${XDG_STATE_HOME:-$HOME/.local/state}/gotg/app"
_gotg_stamp="$(dirname "$_gotg_app")/.app-built"

# Only when something actually changed. A bare `nix build` costs a couple of
# seconds of evaluation, and paying that on every prompt is how people start
# turning direnv off.
if [ ! -e "$_gotg_app" ] || [ ! -e "$_gotg_stamp" ] ||
  [ -n "$(find src/client flake.nix flake.lock -newer "$_gotg_stamp" -print -quit 2>/dev/null || true)" ]; then
  log_status "rebuilding gotg -> $_gotg_app"
  if nix build .#gotg -o "$_gotg_app"; then
    mkdir -p "$(dirname "$_gotg_stamp")"
    touch "$_gotg_stamp"
  else
    log_error "gotg did not build; $_gotg_app is still the previous one"
  fi
fi

# A flake only sees git-tracked files, so a brand-new lib/*.sh is simply absent
# from the build — which looks exactly like the change having no effect. This
# has cost an afternoon twice, so it is said out loud rather than discovered.
# src/ui as well as src/client: clones.py and steamdeck.svg were each written,
# used all evening from the shell, and missing from every `nix build`.
_gotg_untracked="$(git ls-files --others --exclude-standard src/client src/ui config 2>/dev/null || true)"
if [ -n "$_gotg_untracked" ]; then
  log_error "untracked, so NOT in the build: $(echo "$_gotg_untracked" | tr '\n' ' ')"
  log_error "  git add them, or the built app will not have them"
fi

# And the library's pin of this repository, which is the one copy this
# directory cannot override: a launch from Steam or a terminal without direnv
# runs what `nix run <library>#update` built from it. One three days old had
# no ready-up door in its gate and started games the moment a pad was seated,
# while every test here passed. Said rather than moved: a flake update and a
# rebuild do not belong on a `cd`.
_gotg_head="$(git rev-parse HEAD 2>/dev/null || true)"
_gotg_library="${GOTG_LIBRARY:-$(jq -r '.library // empty' "${XDG_CONFIG_HOME:-$HOME/.config}/gotg/config.json" 2>/dev/null || true)}"
_gotg_rev=""
if [ -n "$_gotg_library" ] && [ -f "$_gotg_library/flake.lock" ]; then
  _gotg_rev="$(jq -r '.nodes.gotg.locked.rev // empty' "$_gotg_library/flake.lock" 2>/dev/null || true)"
fi
if [ -n "$_gotg_rev" ] && [ "$_gotg_rev" != "$_gotg_head" ]; then
  _gotg_behind="$(git rev-list --count "$_gotg_rev..HEAD" 2>/dev/null || true)"
  _gotg_ahead="$(git rev-list --count origin/master..HEAD 2>/dev/null || echo 0)"
  if [ "${_gotg_ahead:-0}" -gt 0 ]; then
    log_error "the library's gotg is ${_gotg_behind:-?} behind: git push && nix flake update gotg --flake $_gotg_library && nix run $_gotg_library#update"
  else
    log_error "the library's gotg is ${_gotg_behind:-?} behind: nix flake update gotg --flake $_gotg_library && nix run $_gotg_library#update"
  fi
fi

unset _gotg_app _gotg_stamp _gotg_untracked _gotg_head _gotg_library _gotg_rev _gotg_behind _gotg_ahead

# direnv can't export `complete` registrations, but the lazy loader searches
# XDG_DATA_DIRS at TAB time — publish the checkout's completion there.
mkdir -p .direnv/share/bash-completion/completions
ln -sf "$PWD/src/client/completions/gotg.bash" .direnv/share/bash-completion/completions/gotg
path_add XDG_DATA_DIRS "$PWD/.direnv/share"
