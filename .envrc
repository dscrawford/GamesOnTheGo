use flake .

# Keep the built app in step with the checkout.
#
# `gotg` inside this shell runs the working tree, but a Steam launcher does not:
# it execs ~/.local/state/gotg/app, a `nix build -o` symlink that stays at
# whatever it was last built from. So testing a change by launching the game
# from Steam tested yesterday's code — a slow and confusing way to find out.
#
# watch_dir makes direnv reload when anything under src/client/ changes; `use flake`
# already watches flake.nix and flake.lock.
watch_dir src/client

_gotg_app="${XDG_STATE_HOME:-$HOME/.local/state}/gotg/app"
_gotg_stamp="$(dirname "$_gotg_app")/.app-built"

# Only when something actually changed. A bare `nix build` costs a couple of
# seconds of evaluation, and paying that on every prompt is how people start
# turning direnv off.
if [ ! -e "$_gotg_app" ] || [ ! -e "$_gotg_stamp" ] ||
  [ -n "$(find src/client flake.nix flake.lock -newer "$_gotg_stamp" -print -quit 2>/dev/null || true)" ]; then
  log_status "rebuilding gotg -> $_gotg_app"
  if nix build .#gotg -o "$_gotg_app"; then
    mkdir -p "$(dirname "$_gotg_stamp")"
    touch "$_gotg_stamp"
  else
    log_error "gotg did not build; $_gotg_app is still the previous one"
  fi
fi

# A flake only sees git-tracked files, so a brand-new lib/*.sh is simply absent
# from the build — which looks exactly like the change having no effect. This
# has cost an afternoon twice, so it is said out loud rather than discovered.
_gotg_untracked="$(git ls-files --others --exclude-standard src/client 2>/dev/null || true)"
if [ -n "$_gotg_untracked" ]; then
  log_error "untracked, so NOT in the build: $(echo "$_gotg_untracked" | tr '\n' ' ')"
  log_error "  git add them, or the built app will not have them"
fi

unset _gotg_app _gotg_stamp _gotg_untracked
