# Nix build outputs / GC roots
result
result-*

# node, which this project has none of: the directory only ever appears when a
# tool of somebody's — an MCP server here — installs itself into the working
# directory it happened to be started from.
node_modules/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/

# Local runtime state (never committed)
/state/

# direnv caches: symlinks into the store, never part of the source
.direnv/

# Agent tool state, never source
.swarm/
ruvector.db
.claude-flow/

# Built by src/ui/build-controllers.py at build time.
src/ui/assets/built/

# The Rust workspace's build output.
/rust/target/
