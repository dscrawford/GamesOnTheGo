#!/usr/bin/env bash
# GamesOnTheGo — download a game from the server on demand and launch it.
#
# Dispatch only; each command lives in its own lib/cmd-*.sh.
set -euo pipefail

# Resolve the library next to this script so the CLI works both from a checkout
# and from the nix store.
# Filled in by the build; a checkout has none and says so rather than claiming
# a number nobody set.
GOTG_VERSION="@version@"

GOTG_ROOT="${GOTG_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
GOTG_LIB="$GOTG_ROOT/lib"
GOTG_DATA="${GOTG_DATA:-$GOTG_ROOT/data}"
GOTG_TEMPLATES="${GOTG_TEMPLATES:-$GOTG_ROOT/templates}"
# The emulator environments. Only their file names are read here — building one
# is the flake's job — so this copy is enough to know what a game will run in.
GOTG_ENV_DIR="${GOTG_ENV_DIR:-$GOTG_ROOT/env}"
export GOTG_ROOT GOTG_LIB GOTG_DATA GOTG_TEMPLATES GOTG_ENV_DIR

# shellcheck source=lib/color.sh
source "$GOTG_LIB/color.sh"
# shellcheck source=lib/common.sh
source "$GOTG_LIB/common.sh"
# shellcheck source=lib/config.sh
source "$GOTG_LIB/config.sh"
# shellcheck source=lib/storage.sh
source "$GOTG_LIB/storage.sh"
# shellcheck source=lib/manifest.sh
source "$GOTG_LIB/manifest.sh"
# shellcheck source=lib/download.sh
source "$GOTG_LIB/download.sh"
# shellcheck source=lib/env.sh
source "$GOTG_LIB/env.sh"
# shellcheck source=lib/launcher.sh
source "$GOTG_LIB/launcher.sh"
# shellcheck source=lib/versions.sh
source "$GOTG_LIB/versions.sh"
# shellcheck source=lib/padmap.sh
source "$GOTG_LIB/padmap.sh"
# shellcheck source=lib/killswitch.sh
source "$GOTG_LIB/killswitch.sh"
# shellcheck source=lib/cmd-play.sh
source "$GOTG_LIB/cmd-play.sh"
# shellcheck source=lib/cmd-uninstall.sh
source "$GOTG_LIB/cmd-uninstall.sh"
# shellcheck source=lib/qa-analyze.sh
source "$GOTG_LIB/qa-analyze.sh"
# shellcheck source=lib/cmd-qa.sh
source "$GOTG_LIB/cmd-qa.sh"
# shellcheck source=lib/pads.sh
source "$GOTG_LIB/pads.sh"
# shellcheck source=lib/pads-dolphin.sh
source "$GOTG_LIB/pads-dolphin.sh"
# shellcheck source=lib/pads-ryujinx.sh
source "$GOTG_LIB/pads-ryujinx.sh"
# shellcheck source=lib/pads-cemu.sh
source "$GOTG_LIB/pads-cemu.sh"
# shellcheck source=lib/keys.sh
source "$GOTG_LIB/keys.sh"
# shellcheck source=lib/firmware.sh
source "$GOTG_LIB/firmware.sh"
# shellcheck source=lib/remote.sh
source "$GOTG_LIB/remote.sh"
# shellcheck source=lib/saves.sh
source "$GOTG_LIB/saves.sh"
# shellcheck source=lib/cmd-saves.sh
source "$GOTG_LIB/cmd-saves.sh"
# shellcheck source=lib/cmd-controllers.sh
source "$GOTG_LIB/cmd-controllers.sh"
# shellcheck source=lib/cmd-configure.sh
source "$GOTG_LIB/cmd-configure.sh"
# shellcheck source=lib/cmd-steam.sh
source "$GOTG_LIB/cmd-steam.sh"
# shellcheck source=lib/cmd-admin.sh
source "$GOTG_LIB/cmd-admin.sh"
# shellcheck source=lib/cmd-complete.sh
source "$GOTG_LIB/cmd-complete.sh"

# The store path as well as the number, because on this machine the number is
# the less useful half: every build of an unchanged tree reports 0.1.0, and the
# path is what says *which* one is on PATH. From a checkout it is the working
# copy, which is the same answer to the same question.
cmd_version() {
  if [[ "$GOTG_VERSION" == @*@ ]]; then
    printf 'gotg (unbuilt checkout)\n'
  else
    printf 'gotg %s\n' "$GOTG_VERSION"
  fi
  printf '%s\n' "$GOTG_ROOT"
}

usage() {
  cat <<'EOF'
usage: gotg <command> [args]

  login [--claim <url>]  save the server URL and credentials (mode 600);
                     --claim exchanges a single-use invite link for a token
  admin <command>    mint invites, list and revoke tokens (admin help)
  refresh            re-fetch the game catalog from the server
  list [pattern] [page]  games matching a regex on id, title or platform,
                     marking the ones installed here; a bare number is the
                     page (--platform <p>, --installed, --all, --limit N)
  info <id>          show one game's details, its mods included
  download <id>      fetch a game without setting up a launcher
  install <id>       fetch it, build its environment, write a Steam launcher
  uninstall <id>     remove the game and its launchers; saves stay
  play <id> [variant] fetch and build whatever is missing, then launch
                     --version <v> runs a particular update of the game
  versions <id> [variant]
                     which updates of a game are here, and which one runs
  qa <id> [variant]  run it headless with a virtual pad and grade the recording
  saves <command>    move saves between machines (saves help for the rest)
  controllers <cmd>  what SDL sees, and where its inputs land
  configure <id> [variant]
                     open that environment's own emulator settings
  configure storage  where games are kept: list, add, remove, default
  steam <command>    add / remove / list non-Steam games (steam help)
  sync [--force]     rebuild gotg and the environment GC roots after a git pull
  version            which gotg this is, and where it was installed from

Ids look like usa.legend_of_zelda_majoras_mask. When the same id exists on more
than one platform, qualify it: n64/usa.bugs_life

gotg ships no games. The library it downloads from is your own server, holding
games you have obtained legally: your own dumps, or digital purchases.

A game runs in an environment built from the flake: src/client/env/<platform>.nix,
or src/client/env/games/<platform>/<id>.nix where one game wants its own settings.
`play` builds a missing environment on the spot, which compiles an emulator the
first time and is far happier in a terminal than under Steam — so running
`install` once, from a terminal, is still the smoother way in.
EOF
}

# One usage line per leaf command. The group commands (steam, saves,
# controllers) print their own, richer, subcommand help and are not here.
command_help() {
  case "$1" in
    login) echo "usage: gotg login [--claim <url>]    — save the server URL and token (a claim url is a single-use invite), stored mode 600" ;;
    refresh) echo "usage: gotg refresh  — re-fetch the game catalog from the server" ;;
    versions) echo "usage: gotg versions <id> [variant]  — which installed versions there are, and which one a launch would run" ;;
    list | ls)
      cat <<'EOF'
usage: gotg list [pattern] [page] [--search <re>] [--platform <p>] [--installed] [--page N] [--all] [--limit N]

  Lists the catalog, marking the games installed here. A bare argument is a
  pattern (a regex over id, title and platform) or, if it is a number, the
  page; --search and --page are the named spellings of those two.

    gotg list zelda                       every Zelda, on any platform
    gotg list --platform nes --page 2     the second page of the NES set
    gotg list --search zelda --platform nes
    gotg list --installed                 only what is downloaded here
    gotg list --all                       every game, no paging
EOF
      ;;
    info | show) echo "usage: gotg info <id>    — one game's details and its mods" ;;
    download | get) echo "usage: gotg download <id>    — fetch a game without a launcher" ;;
    install) echo "usage: gotg install <id>    — fetch it, build its environment, write a Steam launcher" ;;
    uninstall) echo "usage: gotg uninstall <id>    — remove the game's files and launchers; saves and settings stay" ;;
    play | launch) echo "usage: gotg play <id> [variant] [emulator args...]    — build whatever is missing, then launch" ;;
    configure)
      cat <<'EOF'
usage: gotg configure <id> [variant]    — open that environment's own settings screen
       gotg configure storage [list [--json] | add <dir> | remove <dir> | default <dir>]
                                        — where games are kept; the first is where downloads land
EOF
      ;;
    sync) echo "usage: gotg sync [--force]    — rebuild every already-built environment from the flake; a flake unchanged since the last sync is skipped unless forced" ;;
  esac
}

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift || true
  # Before anything names a path: the games directory may be configured.
  storage_init

  # Every leaf command answers -h/--help. The group commands handle their own.
  case "$cmd" in
    login | refresh | list | ls | info | show | download | get | install | uninstall | play | launch | configure | sync | versions)
      case "${1:-}" in
        -h | --help) command_help "$cmd"; return 0 ;;
      esac
      ;;
  esac

  case "$cmd" in
    login) cmd_login "$@" ;;
    refresh) cmd_refresh "$@" ;;
    list | ls) cmd_list "$@" ;;
    info | show) cmd_info "$@" ;;
    download | get) cmd_download "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    play | launch) cmd_play "$@" ;;
    versions) cmd_versions "$@" ;;
    qa) cmd_qa "$@" ;;
    saves) cmd_saves "$@" ;;
    controllers) cmd_controllers "$@" ;;
    configure) cmd_configure "$@" ;;
    steam) cmd_steam "$@" ;;
    admin) cmd_admin "$@" ;;
    version | --version | -V) cmd_version ;;
    # Not in the usage: this is what shell completion calls.
    complete) cmd_complete "$@" ;;
    sync) cmd_sync "$@" ;;
    help | --help | -h | "") usage ;;
    *)
      printf 'error: unknown command: %s\n\n' "$cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
